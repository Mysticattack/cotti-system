# Discord Bot Token (von https://discord.com/developers/applications)
DISCORD_TOKEN=dein_discord_token_hier

# Stable Diffusion API Key (von https://stablediffusionapi.com, kostenlos)
STABLEDIFFUSION_API_KEY=

# Bot-Owner fuer /abwesend Befehl
# Discord User-ID (Rechtsklick auf deinen Namen -> ID kopieren, Entwicklermodus benoetigt)
OWNER_DISCORD_ID=
# WhatsApp Nummer mit Laendervorwahl ohne + (z.B. 4915123456789)
OWNER_WHATSAPP_NUMBER=
